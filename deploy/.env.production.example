# Copy to the deployment secret store or to .env on a secured Docker VPS.
# Never commit populated production credentials.
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=4000
WEB_URL=https://shop.example.com
APP_VERSION=0.1.0
RELEASE_SHA=replace-with-release-sha
DEPLOYMENT_ENVIRONMENT=production

DATABASE_URL=mysql://veyora:replace-me@database-host:3306/veyora
JWT_ACCESS_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-of-at-least-32-characters
COOKIE_SECRET=replace-with-a-third-random-secret-of-at-least-32-characters
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12
API_RATE_LIMIT_MAX=240
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_REGISTER_RATE_LIMIT_MAX=5
SLOW_QUERY_THRESHOLD_MS=250

METRICS_TOKEN=replace-with-a-random-monitoring-token-of-at-least-32-characters
WORKER_POLL_INTERVAL_MS=5000
WORKER_BATCH_SIZE=10
RECONCILIATION_MIN_AGE_MINUTES=5
RETURN_WINDOW_DAYS=30
SESSION_RETENTION_DAYS=30

SAFEPAY_ENABLED=false
SAFEPAY_ENVIRONMENT=sandbox
SAFEPAY_PUBLIC_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=

SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Docker Compose only. Change every default before a public deployment.
MYSQL_DATABASE=veyora
MYSQL_USER=veyora
MYSQL_PASSWORD=replace-with-a-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password
DOCKER_DATABASE_URL=mysql://veyora:replace-with-a-database-password@mysql:3306/veyora
PUBLIC_WEB_URL=https://shop.example.com
