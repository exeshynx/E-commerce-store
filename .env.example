# Application
NODE_ENV=development
API_HOST=0.0.0.0
API_PORT=4000
API_URL=http://localhost:4000
WEB_URL=http://localhost:5173
APP_VERSION=0.1.0
RELEASE_SHA=local
DEPLOYMENT_ENVIRONMENT=local

# Laragon MySQL (default local root account with a blank password)
DATABASE_URL=mysql://root:@localhost:3306/aurelia

# Replace these with unique random values before sharing or deploying.
# Each secret must be at least 32 characters.
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-another-32-random-string
COOKIE_SECRET=replace-with-a-third-32-character-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
BCRYPT_ROUNDS=12
API_RATE_LIMIT_MAX=240
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_REGISTER_RATE_LIMIT_MAX=5
SLOW_QUERY_THRESHOLD_MS=250

# Safepay hosted checkout (optional until you have your own sandbox credentials)
# Set SAFEPAY_ENABLED=true only after all three credentials are configured.
SAFEPAY_ENABLED=false
SAFEPAY_ENVIRONMENT=sandbox
SAFEPAY_PUBLIC_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=

# SMTP notifications. Leave disabled to retain queued mail without attempting delivery.
SMTP_ENABLED=false
# Campaigns and transactional notifications are sent server-side over SMTP. Never expose these values through VITE_* variables.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Background worker
WORKER_POLL_INTERVAL_MS=5000
WORKER_BATCH_SIZE=10
RECONCILIATION_MIN_AGE_MINUTES=5
RETURN_WINDOW_DAYS=30
SESSION_RETENTION_DAYS=30

# Required in production; protects /metrics and /health/operational.
METRICS_TOKEN=

# Leave blank in local development to use the Vite /api proxy.
VITE_API_URL=

# Optional: required only when running `npm run admin:bootstrap`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=
ADMIN_LAST_NAME=
