generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum UserRole {
  ADMIN
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OrderStatus {
  PENDING
  AWAITING_PAYMENT
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentProvider {
  MANUAL
  SAFEPAY
  STRIPE
  PAYPAL
  OTHER
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentWebhookProcessingStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

enum PaymentRefundStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

enum OrderStatusActorType {
  ADMIN
  SYSTEM
}

enum ShipmentStatus {
  PACKING
  READY_TO_SHIP
  SHIPPED
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
}

enum EmailNotificationType {
  ORDER_CONFIRMATION
  PAYMENT_SUCCESS
  SHIPMENT_NOTIFICATION
  DELIVERY_CONFIRMATION
  RETURN_REQUESTED
  RETURN_APPROVED
  RETURN_REJECTED
  REFUND_COMPLETED
  SUPPORT_TICKET_CREATED
  SUPPORT_ADMIN_REPLY
  SUPPORT_TICKET_RESOLVED
  CAMPAIGN_MESSAGE
}

enum CampaignAudience {
  ALL_REGISTERED
  CUSTOMERS_WITH_CARTS
  PURCHASERS
}

enum CampaignStatus {
  DRAFT
  QUEUED
}

enum EmailQueueStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  DEAD_LETTER
}

enum AdminAuditAction {
  ADMIN_LOGIN
  PRODUCT_CREATED
  PRODUCT_UPDATED
  PRODUCT_ARCHIVED
  PRODUCT_RESTORED
  PRODUCT_IMAGE_ADDED
  PRODUCT_IMAGE_UPDATED
  PRODUCT_IMAGE_REMOVED
  CATEGORY_CREATED
  CATEGORY_UPDATED
  CATEGORY_ARCHIVED
  CATEGORY_RESTORED
  INVENTORY_UPDATED
  PAYMENT_REFUND_CREATED
  SHIPMENT_CREATED
  SHIPMENT_UPDATED
  SHIPMENT_STATUS_CHANGED
  RETURN_APPROVED
  RETURN_REJECTED
  RETURN_ITEM_RECEIVED
  RETURN_INSPECTED
  RETURN_REFUND_INITIATED
  RETURN_CLOSED
  RETURN_SHIPMENT_UPDATED
  RETURN_SHIPMENT_STATUS_CHANGED
  SUPPORT_TICKET_REPLIED
  SUPPORT_TICKET_ASSIGNED
  SUPPORT_TICKET_PRIORITY_CHANGED
  SUPPORT_TICKET_STATUS_CHANGED
  REVIEW_APPROVED
  REVIEW_REJECTED
  REVIEW_DELETED
  REVIEW_RESTORED
  COUPON_CREATED
  COUPON_UPDATED
  COUPON_ENABLED
  COUPON_DISABLED
  PRODUCT_FEATURED
  PRODUCT_UNFEATURED
  CAMPAIGN_CREATED
  CAMPAIGN_QUEUED
}

enum AdminAuditEntityType {
  USER
  PRODUCT
  CATEGORY
  INVENTORY
  PAYMENT_REFUND
  SHIPMENT
  RETURN_REQUEST
  RETURN_SHIPMENT
  SUPPORT_TICKET
  REVIEW
  COUPON
  CAMPAIGN
}

enum ReturnReason {
  DAMAGED
  DEFECTIVE
  WRONG_ITEM
  NOT_AS_DESCRIBED
  SIZE_OR_FIT
  CHANGED_MIND
  OTHER
}

enum ReturnStatus {
  REQUESTED
  APPROVED
  REJECTED
  ITEM_RECEIVED
  INSPECTED
  REFUND_PENDING
  REFUNDED
  CLOSED
}

enum ReturnShipmentStatus {
  AWAITING_SHIPMENT
  SHIPPED
  IN_TRANSIT
  DELIVERED
  RETURNED_TO_SENDER
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CouponType {
  FIXED_AMOUNT
  PERCENTAGE
}

model User {
  id                     String                @id @default(uuid()) @db.Char(36)
  email                  String                @unique @db.VarChar(254)
  passwordHash           String                @map("password_hash") @db.VarChar(255)
  firstName              String                @map("first_name") @db.VarChar(80)
  lastName               String                @map("last_name") @db.VarChar(80)
  role                   UserRole              @default(CUSTOMER)
  status                 UserStatus            @default(ACTIVE)
  isGuest                Boolean               @default(false) @map("is_guest")
  sessions               AuthSession[]
  guestSession           GuestSession?
  cart                   Cart?
  wishlist               Wishlist?
  orders                 Order[]
  orderStatusChanges     OrderStatusHistory[]  @relation("OrderStatusChangedBy")
  shipmentEvents         ShipmentEvent[]       @relation("ShipmentEventAdministrator")
  adminAuditLogs         AdminAuditLog[]       @relation("AdminAuditAdministrator")
  returnRequests         ReturnRequest[]
  returnShipmentEvents   ReturnShipmentEvent[] @relation("ReturnShipmentEventAdministrator")
  supportTickets         SupportTicket[]       @relation("SupportTicketCustomer")
  assignedSupportTickets SupportTicket[]       @relation("SupportTicketAssignee")
  supportMessages        SupportMessage[]      @relation("SupportMessageAuthor")
  phone                  String?               @db.VarChar(32)
  avatarUrl              String?               @map("avatar_url") @db.VarChar(500)
  avatarAltText          String?               @map("avatar_alt_text") @db.VarChar(160)
  addresses              Address[]
  reviews                Review[]              @relation("ReviewAuthor")
  moderatedReviews       Review[]              @relation("ReviewModerator")
  couponUsages           CouponUsage[]
  productViews           ProductView[]
  campaignsCreated       Campaign[]            @relation("CampaignCreator")
  campaignRecipients     CampaignRecipient[]
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")

  @@index([role, status, createdAt])
  @@map("users")
}

model GuestSession {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @unique @map("user_id") @db.Char(36)
  tokenHash String   @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([expiresAt])
  @@map("guest_sessions")
}

model AuthSession {
  id               String    @id @default(uuid()) @db.Char(36)
  userId           String    @map("user_id") @db.Char(36)
  refreshTokenHash String    @map("refresh_token_hash") @db.Char(64)
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model Category {
  id          String    @id @default(uuid()) @db.Char(36)
  name        String    @unique @db.VarChar(120)
  slug        String    @unique @db.VarChar(140)
  description String?   @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  products    Product[]
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([isActive, name])
  @@map("categories")
}

model Product {
  id            String         @id @default(uuid()) @db.Char(36)
  categoryId    String         @map("category_id") @db.Char(36)
  name          String         @db.VarChar(180)
  slug          String         @unique @db.VarChar(200)
  sku           String         @unique @db.VarChar(64)
  description   String         @db.Text
  price         Decimal        @db.Decimal(12, 2)
  currency      String         @default("PKR") @db.Char(3)
  isActive      Boolean        @default(true) @map("is_active")
  isFeatured    Boolean        @default(false) @map("is_featured")
  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  images        ProductImage[]
  inventory     Inventory?
  cartItems     CartItem[]
  wishlistItems WishlistItem[]
  orderItems    OrderItem[]
  reviews       Review[]
  views         ProductView[]
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@index([categoryId, isActive])
  @@index([isActive, createdAt])
  @@index([isFeatured, isActive, createdAt])
  @@index([name])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Char(36)
  productId String   @map("product_id") @db.Char(36)
  path      String   @db.VarChar(500)
  altText   String?  @map("alt_text") @db.VarChar(160)
  position  Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([productId, position])
  @@index([productId])
  @@map("product_images")
}

model Inventory {
  id                String   @id @default(uuid()) @db.Char(36)
  productId         String   @unique @map("product_id") @db.Char(36)
  availableQuantity Int      @default(0) @map("available_quantity")
  reservedQuantity  Int      @default(0) @map("reserved_quantity")
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("inventory")
}

model Cart {
  id        String     @id @default(uuid()) @db.Char(36)
  userId    String     @unique @map("user_id") @db.Char(36)
  currency  String?    @db.Char(3)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Char(36)
  cartId    String   @map("cart_id") @db.Char(36)
  productId String   @map("product_id") @db.Char(36)
  quantity  Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(12, 2)
  currency  String   @db.Char(3)
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([cartId, productId])
  @@index([productId])
  @@map("cart_items")
}

model Wishlist {
  id        String         @id @default(uuid()) @db.Char(36)
  userId    String         @unique @map("user_id") @db.Char(36)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     WishlistItem[]
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(uuid()) @db.Char(36)
  wishlistId String   @map("wishlist_id") @db.Char(36)
  productId  String   @map("product_id") @db.Char(36)
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([wishlistId, productId])
  @@index([productId])
  @@map("wishlist_items")
}

model Order {
  id                  String                   @id @default(uuid()) @db.Char(36)
  userId              String                   @map("user_id") @db.Char(36)
  orderNumber         String                   @unique @map("order_number") @db.VarChar(32)
  status              OrderStatus              @default(PENDING)
  currency            String                   @db.Char(3)
  subtotal            Decimal                  @db.Decimal(18, 2)
  discountAmount      Decimal                  @default(0) @map("discount_amount") @db.Decimal(18, 2)
  total               Decimal                  @db.Decimal(18, 2)
  couponId            String?                  @map("coupon_id") @db.Char(36)
  couponCode          String?                  @map("coupon_code") @db.VarChar(64)
  couponType          CouponType?              @map("coupon_type")
  couponValue         Decimal?                 @map("coupon_value") @db.Decimal(12, 2)
  idempotencyKey      String                   @map("idempotency_key") @db.VarChar(128)
  checkoutFingerprint String                   @map("checkout_fingerprint") @db.Char(64)
  user                User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  items               OrderItem[]
  shippingAddress     ShippingAddressSnapshot?
  statusHistory       OrderStatusHistory[]
  paymentAttempts     PaymentAttempt[]
  shipment            Shipment?
  emailQueueItems     EmailQueueItem[]
  returnRequests      ReturnRequest[]
  supportTickets      SupportTicket[]
  coupon              Coupon?                  @relation(fields: [couponId], references: [id], onDelete: Restrict)
  couponUsage         CouponUsage?
  createdAt           DateTime                 @default(now()) @map("created_at")
  updatedAt           DateTime                 @updatedAt @map("updated_at")

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([couponId])
  @@map("orders")
}

model OrderItem {
  id           String       @id @default(uuid()) @db.Char(36)
  orderId      String       @map("order_id") @db.Char(36)
  productId    String       @map("product_id") @db.Char(36)
  productName  String       @map("product_name") @db.VarChar(180)
  sku          String       @db.VarChar(64)
  unitPrice    Decimal      @map("unit_price") @db.Decimal(12, 2)
  currency     String       @db.Char(3)
  quantity     Int
  lineSubtotal Decimal      @map("line_subtotal") @db.Decimal(18, 2)
  order        Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  returnItems  ReturnItem[]
  createdAt    DateTime     @default(now()) @map("created_at")

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model ShippingAddressSnapshot {
  id         String   @id @default(uuid()) @db.Char(36)
  orderId    String   @unique @map("order_id") @db.Char(36)
  fullName   String   @map("full_name") @db.VarChar(160)
  phone      String   @db.VarChar(32)
  email      String   @db.VarChar(254)
  country    String   @db.VarChar(100)
  province   String   @db.VarChar(100)
  city       String   @db.VarChar(100)
  postalCode String   @map("postal_code") @db.VarChar(20)
  address    String   @db.Text
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("shipping_address_snapshots")
}

model OrderStatusHistory {
  id              String               @id @default(uuid()) @db.Char(36)
  orderId         String               @map("order_id") @db.Char(36)
  previousStatus  OrderStatus          @map("previous_status")
  newStatus       OrderStatus          @map("new_status")
  administratorId String?              @map("administrator_id") @db.Char(36)
  actorType       OrderStatusActorType @default(ADMIN) @map("actor_type")
  systemActor     String?              @map("system_actor") @db.VarChar(100)
  note            String?              @db.VarChar(500)
  order           Order                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  administrator   User?                @relation("OrderStatusChangedBy", fields: [administratorId], references: [id], onDelete: Restrict)
  createdAt       DateTime             @default(now()) @map("created_at")

  @@index([orderId, createdAt])
  @@index([administratorId, createdAt])
  @@map("order_status_history")
}

model PaymentAttempt {
  id                     String                @id @default(uuid()) @db.Char(36)
  orderId                String                @map("order_id") @db.Char(36)
  provider               PaymentProvider
  status                 PaymentStatus         @default(PENDING)
  providerPaymentId      String?               @map("provider_payment_id") @db.VarChar(191)
  providerIdempotencyKey String?               @map("provider_idempotency_key") @db.VarChar(128)
  amount                 Decimal               @db.Decimal(12, 2)
  currency               String                @db.Char(3)
  failureReason          String?               @map("failure_reason") @db.VarChar(500)
  metadata               Json?
  order                  Order                 @relation(fields: [orderId], references: [id], onDelete: Restrict)
  webhookEvents          PaymentWebhookEvent[]
  refunds                PaymentRefund[]
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")

  @@unique([provider, providerIdempotencyKey])
  @@index([orderId, createdAt])
  @@index([provider, providerPaymentId])
  @@index([status, createdAt])
  @@map("payment_attempts")
}

model PaymentWebhookEvent {
  id                  String                         @id @default(uuid()) @db.Char(36)
  provider            PaymentProvider
  externalEventId     String                         @map("external_event_id") @db.VarChar(191)
  eventType           String                         @map("event_type") @db.VarChar(191)
  payload             Json
  paymentAttemptId    String?                        @map("payment_attempt_id") @db.Char(36)
  processingStatus    PaymentWebhookProcessingStatus @default(RECEIVED) @map("processing_status")
  processingAttempts  Int                            @default(0) @map("processing_attempts")
  processingStartedAt DateTime?                      @map("processing_started_at")
  providerCreatedAt   DateTime?                      @map("provider_created_at")
  signatureVerified   Boolean                        @default(true) @map("signature_verified")
  lastError           String?                        @map("last_error") @db.VarChar(1000)
  processedAt         DateTime?                      @map("processed_at")
  paymentAttempt      PaymentAttempt?                @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  createdAt           DateTime                       @default(now()) @map("created_at")
  updatedAt           DateTime                       @updatedAt @map("updated_at")

  @@unique([provider, externalEventId])
  @@index([paymentAttemptId, createdAt])
  @@index([provider, eventType, createdAt])
  @@index([processingStatus, createdAt])
  @@map("payment_webhook_events")
}

model PaymentRefund {
  id                     String              @id @default(uuid()) @db.Char(36)
  paymentAttemptId       String              @map("payment_attempt_id") @db.Char(36)
  providerRefundId       String?             @map("provider_refund_id") @db.VarChar(191)
  providerIdempotencyKey String              @unique @map("provider_idempotency_key") @db.VarChar(128)
  status                 PaymentRefundStatus @default(PENDING)
  amount                 Decimal             @db.Decimal(12, 2)
  currency               String              @db.Char(3)
  reason                 String?             @db.VarChar(500)
  failureReason          String?             @map("failure_reason") @db.VarChar(500)
  metadata               Json?
  paymentAttempt         PaymentAttempt      @relation(fields: [paymentAttemptId], references: [id], onDelete: Restrict)
  returnRequestId        String?             @map("return_request_id") @db.Char(36)
  returnRequest          ReturnRequest?      @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  createdAt              DateTime            @default(now()) @map("created_at")
  updatedAt              DateTime            @updatedAt @map("updated_at")

  @@index([paymentAttemptId, createdAt])
  @@index([providerRefundId])
  @@index([status, createdAt])
  @@index([returnRequestId, createdAt])
  @@map("payment_refunds")
}

model Shipment {
  id             String          @id @default(uuid()) @db.Char(36)
  orderId        String          @unique @map("order_id") @db.Char(36)
  courier        String          @db.VarChar(120)
  trackingNumber String?         @map("tracking_number") @db.VarChar(191)
  status         ShipmentStatus  @default(PACKING)
  shippedAt      DateTime?       @map("shipped_at")
  deliveredAt    DateTime?       @map("delivered_at")
  order          Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  events         ShipmentEvent[]
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([trackingNumber])
  @@map("shipments")
}

model ShipmentEvent {
  id              String          @id @default(uuid()) @db.Char(36)
  shipmentId      String          @map("shipment_id") @db.Char(36)
  administratorId String          @map("administrator_id") @db.Char(36)
  previousStatus  ShipmentStatus? @map("previous_status")
  status          ShipmentStatus
  location        String?         @db.VarChar(160)
  message         String?         @db.VarChar(500)
  occurredAt      DateTime        @default(now()) @map("occurred_at")
  shipment        Shipment        @relation(fields: [shipmentId], references: [id], onDelete: Restrict)
  administrator   User            @relation("ShipmentEventAdministrator", fields: [administratorId], references: [id], onDelete: Restrict)
  createdAt       DateTime        @default(now()) @map("created_at")

  @@index([shipmentId, occurredAt])
  @@index([administratorId, createdAt])
  @@map("shipment_events")
}

model EmailQueueItem {
  id                String                @id @default(uuid()) @db.Char(36)
  orderId           String?               @map("order_id") @db.Char(36)
  returnRequestId   String?               @map("return_request_id") @db.Char(36)
  supportTicketId   String?               @map("support_ticket_id") @db.Char(36)
  campaignId        String?               @map("campaign_id") @db.Char(36)
  notificationType  EmailNotificationType @map("notification_type")
  recipientEmail    String                @map("recipient_email") @db.VarChar(254)
  subject           String                @db.VarChar(255)
  payload           Json
  status            EmailQueueStatus      @default(PENDING)
  attempts          Int                   @default(0)
  maxAttempts       Int                   @default(5) @map("max_attempts")
  availableAt       DateTime              @default(now()) @map("available_at")
  lockedAt          DateTime?             @map("locked_at")
  sentAt            DateTime?             @map("sent_at")
  lastError         String?               @map("last_error") @db.VarChar(1000)
  providerMessageId String?               @map("provider_message_id") @db.VarChar(191)
  deduplicationKey  String                @unique @map("deduplication_key") @db.VarChar(191)
  order             Order?                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  returnRequest     ReturnRequest?        @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  supportTicket     SupportTicket?        @relation(fields: [supportTicketId], references: [id], onDelete: Restrict)
  campaign          Campaign?             @relation(fields: [campaignId], references: [id], onDelete: Restrict)
  createdAt         DateTime              @default(now()) @map("created_at")
  updatedAt         DateTime              @updatedAt @map("updated_at")

  @@index([status, availableAt])
  @@index([orderId, createdAt])
  @@index([returnRequestId, createdAt])
  @@index([supportTicketId, createdAt])
  @@index([campaignId, createdAt])
  @@map("email_queue_items")
}

model Campaign {
  id              String              @id @default(uuid()) @db.Char(36)
  name            String              @db.VarChar(160)
  subject         String              @db.VarChar(255)
  message         String              @db.Text
  audience        CampaignAudience
  status          CampaignStatus      @default(DRAFT)
  createdById     String              @map("created_by_id") @db.Char(36)
  createdBy       User                @relation("CampaignCreator", fields: [createdById], references: [id], onDelete: Restrict)
  recipients      CampaignRecipient[]
  emailQueueItems EmailQueueItem[]
  queuedAt        DateTime?           @map("queued_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([createdById, createdAt])
  @@map("campaigns")
}

model CampaignRecipient {
  id         String   @id @default(uuid()) @db.Char(36)
  campaignId String   @map("campaign_id") @db.Char(36)
  userId     String   @map("user_id") @db.Char(36)
  email      String   @db.VarChar(254)
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([campaignId, userId])
  @@index([userId, createdAt])
  @@map("campaign_recipients")
}

model AdminAuditLog {
  id              String               @id @default(uuid()) @db.Char(36)
  administratorId String               @map("administrator_id") @db.Char(36)
  action          AdminAuditAction
  entityType      AdminAuditEntityType @map("entity_type")
  entityId        String               @map("entity_id") @db.VarChar(191)
  requestId       String?              @map("request_id") @db.VarChar(128)
  metadata        Json?
  administrator   User                 @relation("AdminAuditAdministrator", fields: [administratorId], references: [id], onDelete: Restrict)
  createdAt       DateTime             @default(now()) @map("created_at")

  @@index([administratorId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId, createdAt])
  @@map("admin_audit_logs")
}

model BackgroundJobState {
  name            String    @id @db.VarChar(64)
  lastStartedAt   DateTime? @map("last_started_at")
  lastSucceededAt DateTime? @map("last_succeeded_at")
  lastFailedAt    DateTime? @map("last_failed_at")
  lastError       String?   @map("last_error") @db.VarChar(1000)
  processedCount  Int       @default(0) @map("processed_count")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@map("background_job_states")
}

model ReturnRequest {
  id              String           @id @default(uuid()) @db.Char(36)
  returnNumber    String           @unique @map("return_number") @db.VarChar(32)
  userId          String           @map("user_id") @db.Char(36)
  orderId         String           @map("order_id") @db.Char(36)
  status          ReturnStatus     @default(REQUESTED)
  customerNote    String?          @map("customer_note") @db.VarChar(1000)
  rejectionReason String?          @map("rejection_reason") @db.VarChar(500)
  inspectionNotes String?          @map("inspection_notes") @db.VarChar(2000)
  approvedAt      DateTime?        @map("approved_at")
  receivedAt      DateTime?        @map("received_at")
  inspectedAt     DateTime?        @map("inspected_at")
  refundedAt      DateTime?        @map("refunded_at")
  closedAt        DateTime?        @map("closed_at")
  user            User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  order           Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  items           ReturnItem[]
  shipment        ReturnShipment?
  refunds         PaymentRefund[]
  emailQueueItems EmailQueueItem[]
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([orderId, createdAt])
  @@index([status, createdAt])
  @@map("return_requests")
}

model ReturnItem {
  id              String        @id @default(uuid()) @db.Char(36)
  returnRequestId String        @map("return_request_id") @db.Char(36)
  orderItemId     String        @map("order_item_id") @db.Char(36)
  reason          ReturnReason
  reasonDetails   String?       @map("reason_details") @db.VarChar(500)
  quantity        Int
  productName     String        @map("product_name") @db.VarChar(180)
  sku             String        @db.VarChar(64)
  unitPrice       Decimal       @map("unit_price") @db.Decimal(12, 2)
  currency        String        @db.Char(3)
  refundAmount    Decimal       @map("refund_amount") @db.Decimal(18, 2)
  returnRequest   ReturnRequest @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  orderItem       OrderItem     @relation(fields: [orderItemId], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now()) @map("created_at")

  @@unique([returnRequestId, orderItemId])
  @@index([orderItemId])
  @@map("return_items")
}

model ReturnShipment {
  id              String                @id @default(uuid()) @db.Char(36)
  returnRequestId String                @unique @map("return_request_id") @db.Char(36)
  courier         String?               @db.VarChar(120)
  trackingNumber  String?               @map("tracking_number") @db.VarChar(191)
  status          ReturnShipmentStatus  @default(AWAITING_SHIPMENT)
  shippedAt       DateTime?             @map("shipped_at")
  deliveredAt     DateTime?             @map("delivered_at")
  returnRequest   ReturnRequest         @relation(fields: [returnRequestId], references: [id], onDelete: Restrict)
  events          ReturnShipmentEvent[]
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  @@index([status, createdAt])
  @@index([trackingNumber])
  @@map("return_shipments")
}

model ReturnShipmentEvent {
  id               String                @id @default(uuid()) @db.Char(36)
  returnShipmentId String                @map("return_shipment_id") @db.Char(36)
  administratorId  String                @map("administrator_id") @db.Char(36)
  previousStatus   ReturnShipmentStatus? @map("previous_status")
  status           ReturnShipmentStatus
  location         String?               @db.VarChar(160)
  message          String?               @db.VarChar(500)
  occurredAt       DateTime              @default(now()) @map("occurred_at")
  returnShipment   ReturnShipment        @relation(fields: [returnShipmentId], references: [id], onDelete: Restrict)
  administrator    User                  @relation("ReturnShipmentEventAdministrator", fields: [administratorId], references: [id], onDelete: Restrict)
  createdAt        DateTime              @default(now()) @map("created_at")

  @@index([returnShipmentId, occurredAt])
  @@index([administratorId, createdAt])
  @@map("return_shipment_events")
}

model SupportTicket {
  id              String                @id @default(uuid()) @db.Char(36)
  ticketNumber    String                @unique @map("ticket_number") @db.VarChar(32)
  userId          String                @map("user_id") @db.Char(36)
  orderId         String?               @map("order_id") @db.Char(36)
  assignedToId    String?               @map("assigned_to_id") @db.Char(36)
  subject         String                @db.VarChar(180)
  status          SupportTicketStatus   @default(OPEN)
  priority        SupportTicketPriority @default(MEDIUM)
  resolvedAt      DateTime?             @map("resolved_at")
  closedAt        DateTime?             @map("closed_at")
  user            User                  @relation("SupportTicketCustomer", fields: [userId], references: [id], onDelete: Restrict)
  order           Order?                @relation(fields: [orderId], references: [id], onDelete: Restrict)
  assignedTo      User?                 @relation("SupportTicketAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  messages        SupportMessage[]
  emailQueueItems EmailQueueItem[]
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([assignedToId, status, updatedAt])
  @@index([status, priority, updatedAt])
  @@index([orderId])
  @@map("support_tickets")
}

model SupportMessage {
  id          String             @id @default(uuid()) @db.Char(36)
  ticketId    String             @map("ticket_id") @db.Char(36)
  authorId    String             @map("author_id") @db.Char(36)
  authorRole  UserRole           @map("author_role")
  body        String             @db.Text
  ticket      SupportTicket      @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  author      User               @relation("SupportMessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  attachments TicketAttachment[]
  createdAt   DateTime           @default(now()) @map("created_at")

  @@index([ticketId, createdAt])
  @@index([authorId, createdAt])
  @@map("support_messages")
}

model TicketAttachment {
  id        String         @id @default(uuid()) @db.Char(36)
  messageId String         @map("message_id") @db.Char(36)
  fileName  String         @map("file_name") @db.VarChar(255)
  mediaType String         @map("media_type") @db.VarChar(120)
  sizeBytes Int            @map("size_bytes")
  checksum  String?        @db.Char(64)
  message   SupportMessage @relation(fields: [messageId], references: [id], onDelete: Restrict)
  createdAt DateTime       @default(now()) @map("created_at")

  @@index([messageId])
  @@map("ticket_attachments")
}

model Review {
  id             String       @id @default(uuid()) @db.Char(36)
  productId      String       @map("product_id") @db.Char(36)
  userId         String       @map("user_id") @db.Char(36)
  rating         Int
  title          String?      @db.VarChar(120)
  body           String       @db.Text
  status         ReviewStatus @default(PENDING)
  moderationNote String?      @map("moderation_note") @db.VarChar(500)
  moderatedById  String?      @map("moderated_by_id") @db.Char(36)
  moderatedAt    DateTime?    @map("moderated_at")
  deletedAt      DateTime?    @map("deleted_at")
  product        Product      @relation(fields: [productId], references: [id], onDelete: Restrict)
  user           User         @relation("ReviewAuthor", fields: [userId], references: [id], onDelete: Restrict)
  moderatedBy    User?        @relation("ReviewModerator", fields: [moderatedById], references: [id], onDelete: Restrict)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([userId, productId])
  @@index([productId, status, deletedAt, createdAt])
  @@index([status, deletedAt, createdAt])
  @@index([moderatedById, moderatedAt])
  @@map("reviews")
}

model Coupon {
  id                     String        @id @default(uuid()) @db.Char(36)
  code                   String        @unique @db.VarChar(64)
  description            String?       @db.VarChar(500)
  type                   CouponType
  value                  Decimal       @db.Decimal(12, 2)
  currency               String        @default("PKR") @db.Char(3)
  minimumOrderValue      Decimal?      @map("minimum_order_value") @db.Decimal(12, 2)
  startsAt               DateTime?     @map("starts_at")
  expiresAt              DateTime?     @map("expires_at")
  maximumUses            Int?          @map("maximum_uses")
  maximumUsesPerCustomer Int?          @map("maximum_uses_per_customer")
  isEnabled              Boolean       @default(true) @map("is_enabled")
  orders                 Order[]
  usages                 CouponUsage[]
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  @@index([isEnabled, startsAt, expiresAt])
  @@index([createdAt])
  @@map("coupons")
}

model CouponUsage {
  id             String     @id @default(uuid()) @db.Char(36)
  couponId       String     @map("coupon_id") @db.Char(36)
  orderId        String     @unique @map("order_id") @db.Char(36)
  userId         String     @map("user_id") @db.Char(36)
  couponCode     String     @map("coupon_code") @db.VarChar(64)
  couponType     CouponType @map("coupon_type")
  couponValue    Decimal    @map("coupon_value") @db.Decimal(12, 2)
  discountAmount Decimal    @map("discount_amount") @db.Decimal(18, 2)
  currency       String     @db.Char(3)
  coupon         Coupon     @relation(fields: [couponId], references: [id], onDelete: Restrict)
  order          Order      @relation(fields: [orderId], references: [id], onDelete: Restrict)
  user           User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt      DateTime   @default(now()) @map("created_at")

  @@index([couponId, createdAt])
  @@index([couponId, userId, createdAt])
  @@index([userId, createdAt])
  @@map("coupon_usages")
}

model Address {
  id                String   @id @default(uuid()) @db.Char(36)
  userId            String   @map("user_id") @db.Char(36)
  label             String   @db.VarChar(80)
  fullName          String   @map("full_name") @db.VarChar(160)
  phone             String   @db.VarChar(32)
  email             String   @db.VarChar(254)
  country           String   @db.VarChar(100)
  province          String   @db.VarChar(100)
  city              String   @db.VarChar(100)
  postalCode        String   @map("postal_code") @db.VarChar(20)
  address           String   @db.Text
  isDefaultShipping Boolean  @default(false) @map("is_default_shipping")
  isDefaultBilling  Boolean  @default(false) @map("is_default_billing")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@index([userId, createdAt])
  @@index([userId, isDefaultShipping])
  @@index([userId, isDefaultBilling])
  @@map("addresses")
}

model ProductView {
  id        String   @id @default(uuid()) @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  productId String   @map("product_id") @db.Char(36)
  viewedAt  DateTime @default(now()) @map("viewed_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, productId])
  @@index([userId, viewedAt])
  @@index([productId, viewedAt])
  @@map("product_views")
}
