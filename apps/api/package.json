{
  "name": "@aurelia/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "admin:bootstrap": "tsx src/scripts/bootstrap-admin.ts",
    "build": "tsc -p tsconfig.build.json",
    "db:seed": "prisma db seed",
    "db:status": "prisma migrate status",
    "db:studio": "prisma studio",
    "dev": "tsx watch src/server.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "lint": "eslint . --max-warnings=0",
    "prisma:format": "prisma format",
    "prisma:generate": "prisma generate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "test": "tsx --test --test-concurrency=1 src/core/auth/auth.integration.test.ts src/core/catalog/catalog.integration.test.ts src/core/commerce/commerce.integration.test.ts src/core/orders/order.integration.test.ts src/core/admin/admin.integration.test.ts src/core/payments/payment.integration.test.ts src/core/payments/payment-gateway.integration.test.ts src/core/operations/operations.integration.test.ts src/core/operations/hardening.integration.test.ts src/core/after-sales/after-sales.integration.test.ts src/core/experience/experience.integration.test.ts",
    "typecheck": "tsc --noEmit --pretty false"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@sfpy/node-core": "^0.3.5",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "prisma": "^7.9.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.23.1"
  }
}
